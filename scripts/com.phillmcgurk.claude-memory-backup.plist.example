<?xml version="1.0" encoding="UTF-8"?>
<!--
  RA-1912 — Daily LaunchAgent for claude_memory_backup.sh

  Install (this file is committed as `.plist.example`; copy to a real
  `.plist` in your LaunchAgents dir before loading):
    cp scripts/com.phillmcgurk.claude-memory-backup.plist.example \
       ~/Library/LaunchAgents/com.phillmcgurk.claude-memory-backup.plist
    launchctl load ~/Library/LaunchAgents/com.phillmcgurk.claude-memory-backup.plist

  Verify:
    launchctl list | grep claude-memory
    tail ~/Library/Logs/claude-memory-backup.log

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.phillmcgurk.claude-memory-backup.plist
    rm ~/Library/LaunchAgents/com.phillmcgurk.claude-memory-backup.plist

  Schedule: 03:14 local every day (off-the-hour to spread load).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.phillmcgurk.claude-memory-backup</string>

    <!-- No username is baked in. launchd does NOT expand ~ or $HOME in
         ProgramArguments, so the command runs through `bash -lc` and the shell
         expands $HOME at run time. This previously hardcoded
         /Users/phill-mac/Pi-CEO/..., which meant the agent loaded and then did
         nothing on the other two machines — the same silent-wrong-path failure
         the script itself was just fixed for. Set PI_CEO_REPO only if this
         checkout does not live at $HOME/Pi-Dev-Ops. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>PI_CEO_REPO="${PI_CEO_REPO:-$HOME/Pi-Dev-Ops}"; exec "$PI_CEO_REPO/scripts/claude_memory_backup.sh"</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CLAUDE_MEMORY_REMOTE</key>
        <string>git@github.com:CleanExpo/claude-memory.git</string>
        <key>CLAUDE_MEMORY_BRANCH</key>
        <string>main</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>14</integer>
    </dict>

    <!-- launchd cannot expand $HOME in these two paths, so they use /tmp rather
         than one machine's Library/Logs. Point them at an absolute path under
         your own home if you want the log to persist across reboots. -->
    <key>StandardOutPath</key>
    <string>/tmp/claude-memory-backup.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/claude-memory-backup.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
