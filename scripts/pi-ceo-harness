#!/usr/bin/env bash
# Start Claude or Codex from a verified Pi-CEO Git checkout.
#
# The historic /Users/phill-mac/Pi-CEO/Pi-Dev-Ops path is an operational-data
# wrapper, not a Git checkout. Starting a host there and then asking it to enter
# an existing worktree fails before the Harness gets a chance to admit the task.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: pi-ceo-harness [--repo PATH | --worktree PATH] [--host claude|codex] [--check] [--] [host arguments...]

Starts Claude or Codex only after resolving an exact Git checkout root.
--worktree resumes an existing worktree; --repo selects a normal checkout.
--check prints the resolved root and does not require or start the host.
USAGE
}

default_repo="${PI_CEO_REPO_ROOT:-$HOME/Pi-Dev-Ops}"
legacy_wrapper="$HOME/Pi-CEO/Pi-Dev-Ops"
requested=""
requested_mode=""
host="claude"
check_only=0

while (($#)); do
  case "$1" in
    --repo|--worktree)
      (($# >= 2)) || { echo "ENTRY_BLOCKED missing path after $1" >&2; exit 2; }
      if [[ -n "$requested_mode" ]]; then
        echo "ENTRY_BLOCKED reason=ambiguous_target recovery=pass exactly one of --repo or --worktree" >&2
        exit 2
      fi
      requested="$2"
      requested_mode="$1"
      shift 2
      ;;
    --host)
      (($# >= 2)) || { echo "ENTRY_BLOCKED missing host after --host" >&2; exit 2; }
      case "$2" in
        claude|codex) host="$2" ;;
        *) echo "ENTRY_BLOCKED reason=unsupported_host host=$2" >&2; exit 2 ;;
      esac
      shift 2
      ;;
    --check)
      check_only=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

target="${requested:-$default_repo}"
# Normalise existing directories only. This catches harmless spellings such as a
# trailing slash or `.` while never inventing a real path for arbitrary missing
# input. `pwd -P` intentionally resolves symlinks, so a symlink to the legacy
# wrapper is treated as the wrapper too.
normalise_existing_directory() {
  if [[ -d "$1" ]]; then
    (CDPATH='' cd -- "$1" && pwd -P)
  else
    printf '%s\n' "$1"
  fi
}
target_identity="$(normalise_existing_directory "$target")"
legacy_identity="$(normalise_existing_directory "$legacy_wrapper")"
recovered=0
if [[ "$target_identity" == "$legacy_identity" ]]; then
  target="$default_repo"
  recovered=1
fi

git_clean() {
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_NAMESPACE \
    -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
    -u GIT_COMMON_DIR git "$@"
}

if ! root="$(git_clean -C "$target" rev-parse --show-toplevel 2>/dev/null)"; then
  cat >&2 <<EOF
ENTRY_BLOCKED requested_path=$target
reason=not_a_git_checkout
recovery=use --repo <Git checkout> or --worktree <existing Git worktree>; do not create a repository inside a wrapper directory
EOF
  exit 2
fi

root="$(cd "$root" && pwd -P)"
if ((recovered)); then
  printf 'ENTRY_RECOVERED legacy_wrapper=%s resolved_default=%s\n' \
    "$legacy_wrapper" "$default_repo" >&2
fi
head="$(git_clean -C "$root" rev-parse HEAD)"
branch="$(git_clean -C "$root" branch --show-current || true)"
dirty=0
if [[ -n "$(git_clean -C "$root" status --porcelain)" ]]; then dirty=1; fi

if ((check_only)); then
  printf 'ENTRY_READY worktree=%s head=%s branch=%s dirty=%s host=%s\n' \
    "$root" "$head" "${branch:-DETACHED}" "$dirty" "$host"
  exit 0
fi

if [[ "$host" == claude ]]; then
  configured_bin="${PI_CEO_CLAUDE_BIN:-claude}"
  recovery="install Claude Code or set PI_CEO_CLAUDE_BIN"
else
  configured_bin="${PI_CEO_CODEX_BIN:-codex}"
  recovery="install Codex CLI or set PI_CEO_CODEX_BIN"
fi
host_bin="$(command -v -- "$configured_bin" 2>/dev/null || true)"
if [[ -z "$host_bin" || ! -f "$host_bin" || ! -x "$host_bin" ]]; then
  echo "ENTRY_BLOCKED reason=${host}_not_found recovery=$recovery" >&2
  exit 2
fi
if [[ "$host_bin" != /* ]]; then
  host_dir="$(CDPATH='' cd -- "$(dirname -- "$host_bin")" 2>/dev/null && pwd -P || true)"
  host_bin="${host_dir:+$host_dir/}$(basename -- "$host_bin")"
fi
if [[ "$host_bin" != /* || ! -f "$host_bin" || ! -x "$host_bin" ]]; then
  echo "ENTRY_BLOCKED reason=${host}_not_found recovery=$recovery" >&2
  exit 2
fi

printf 'ENTRY_READY worktree=%s head=%s branch=%s dirty=%s host=%s\n' \
  "$root" "$head" "${branch:-DETACHED}" "$dirty" "$host"
cd "$root"
exec "$host_bin" "$@"
