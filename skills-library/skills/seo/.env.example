# DataForSEO API credentials — sign up at https://l.dataforseo.com/4epETnH ($1 free trial credit)
# API Login is your account email; API Password is the long alphanumeric string at
# https://app.dataforseo.com/api-access (NOT your account login password).
#
# Values are deliberately EMPTY, not placeholder text. `cp .env.example .env` is
# the documented setup step, and placeholder values survive that copy as
# non-empty strings — which defeats a presence check and turns "you haven't set
# credentials yet" into an HTTP 401 traceback from deep inside a request.
# Empty values make the credential guard fire cleanly instead. (2026-08-10)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional — only needed for Semrush-backed commands.
SEMRUSH_API_KEY=
