{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-passport/1",
  "title": "Capability Passport",
  "description": "Generated by skill-watch/scripts/capability_passport.py from one SKILL.md and the trusted records about it. Never hand-edited. capability_passport.py validates against this file with a stdlib subset validator that refuses any keyword it does not implement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "origin", "source", "identity", "owner", "capabilities", "tools", "model", "api_key_lane", "risk", "trust", "tests", "conflicts"],
  "properties": {
    "schema": {"const": "capability-passport/1"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.-]*$"},
    "origin": {"enum": ["local", "vault"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "description_sha256"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "description_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "owner": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "list"],
      "properties": {
        "declared": {"type": "boolean"},
        "list": {"type": "array", "items": {"type": "string"}}
      }
    },
    "model": {"type": ["string", "null"]},
    "api_key_lane": {"type": "boolean"},
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed", "review", "pinned_sha", "registry"],
      "properties": {
        "reviewed": {"type": "boolean"},
        "review": {"type": ["string", "null"]},
        "pinned_sha": {"type": ["string", "null"]},
        "registry": {"type": ["string", "null"]}
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "records", "rejected"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NONE", "STALE", "REJECTED"]},
        "records": {"type": "integer", "minimum": 0},
        "rejected": {"type": "array", "items": {"type": "string"}}
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "owners"],
        "properties": {
          "capability": {"type": "string"},
          "owners": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
