# Copy these names into the host environment. Leave this file blank.
# Never commit real tokens.

# Required. Shared bearer for every bot. At least 16 characters.
ESTATE_MCP_TOKEN=

# Optional. Comma-separated actor labels allowed to write.
# Example: Queue,Scout,Sentinel,Critic,Margot,Projects Manager
ESTATE_MCP_ACTORS=

# Where notes, the queue, and the audit log are stored.
# On Railway, point this at a volume if the feed must survive a redeploy.
ESTATE_MCP_STATE_DIR=

# Pi-CEO API. Default is the production Railway service.
PICEO_BASE_URL=https://pi-dev-ops-production.up.railway.app

# Optional. Same value as TAO_PASSWORD. Unlocks the detailed /health payload.
# It does not unlock /api/mission-control/live (that route wants a dashboard session).
PICEO_BEARER=

# Optional. Read-only GitHub calls for repo status. No call is made when unset.
GITHUB_TOKEN=

# Optional. Read-only Linear calls for the Ready for Pi-Dev queue. No call when unset.
LINEAR_API_KEY=

# Optional path to config/harness/projects.json. Defaults to the repo copy.
ESTATE_PROJECTS_PATH=

PORT=8787
HOST=0.0.0.0
