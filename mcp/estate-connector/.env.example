# Copy these into the host's environment. Leave secrets empty here.
# Never commit a filled-in copy.

# Required. Long random password the bots send as: Authorization: Bearer <value>
ESTATE_MCP_TOKEN=

# Optional. Railway sets PORT. Local default is 8787.
# ESTATE_MCP_PORT=8787
# ESTATE_MCP_HOST=0.0.0.0

# Where shared notes, the queue, and the audit log are stored.
# On Railway, mount a volume and set this to that path (for example /data).
# ESTATE_MCP_DATA_DIR=

# Comma-separated bot names. Defaults to Queue, Scout, Sentinel, Critic, Margot, Projects Manager.
# ESTATE_MCP_BOTS=

# Live Pi-Dev-Ops backend (Mission Control lives on this same service).
# PICEO_BASE_URL=https://pi-dev-ops-production.up.railway.app
# PICEO_BEARER_TOKEN=

# Live Unite-Group site. Status path defaults to /api/health.
# UNITE_BASE_URL=https://unite-group.vercel.app
# UNITE_BEARER_TOKEN=
# UNITE_STATUS_PATH=/api/health
# UNITE_PROJECTS_PATH=

# Live health reads. Each value is the site origin. The path is always /api/health.
# Leave unset to use the default origin. Set a bearer only if that health page is private.
# RESTOREASSIST_BASE_URL=https://restoreassist.app
# RESTOREASSIST_BEARER_TOKEN=
# SYNTHEX_BASE_URL=https://synthex.social
# SYNTHEX_BEARER_TOKEN=
# DRNRPG_BASE_URL=https://dr-nrpg-platform.vercel.app
# DRNRPG_BEARER_TOKEN=
