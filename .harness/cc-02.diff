+/** An exemption names the exact magnitude it excuses, not just the direction. */
+interface DeclaredDelta {
+  /** Count in the baseline. */
+  from: number;
+  /** Count the port is allowed to have — this value and no other. */
+  to: number;
+  reason: string;
