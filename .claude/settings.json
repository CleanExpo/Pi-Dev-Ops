{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(pip:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(make:*)",
      "Bash(./scripts/*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:api.telegram.org)",
      "WebFetch(domain:api.linear.app)",
      "WebFetch(domain:api.anthropic.com)",
      "WebSearch",
      "mcp__pi-ceo__*",
      "mcp__scheduled-tasks__*"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "WebFetch(domain:localhost)",
      "Bash(curl * | sh:*)",
      "Bash(wget * | sh:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/senior-harness/scripts/run_setup_driver.sh\"; [ -f \"$f\" ] || { echo \"senior-harness is not installed on this machine ($f is missing), so its hooks are off (RA-8127).\"; exit 0; }; bash \"$f\" hook --surface claude --event SessionStart --allow-non-git"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/senior-harness/scripts/run_setup_driver.sh\"; [ -f \"$f\" ] || exit 0; bash \"$f\" hook --surface claude --event UserPromptSubmit --allow-non-git"
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/continuation_horizon_hook.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" || exit 1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/senior-harness/scripts/run_setup_driver.sh\"; [ -f \"$f\" ] || exit 0; bash \"$f\" hook --surface claude --event PreToolUse --allow-non-git"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -e \"$HOME/.claude/HARD_STOP\" ] && { printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"HARD_STOP is active, so every tool call is refused until ~/.claude/HARD_STOP is removed (RA-8340).\"}}'; exit 0; }; f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/autonomy_gate_hook.py\"; if [ -f \"$f\" ]; then o=$(python3 \"$f\"); rc=$?; [ \"$rc\" = 0 ] && { [ -n \"$o\" ] && printf '%s\\n' \"$o\"; exit 0; }; why=\"$f exited $rc\"; else why=\"no copy at $f\"; fi; python3 -c 'import json,sys; print(json.dumps({\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"additionalContext\": \"autonomy gate is off: \" + sys.argv[1] + \"; L3 tool calls are not being gated (RA-8340)\"}}))' \"$why\"; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/continuation_horizon_hook.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" || exit 1"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" worktree add \"$WORKTREE_DIR\" -b \"$WORKTREE_BRANCH\" 2>&1"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" worktree remove \"$WORKTREE_DIR\" --force 2>&1"
          }
        ]
      }
    ]
  },
  "attribution": {
    "sessionUrl": false
  }
}